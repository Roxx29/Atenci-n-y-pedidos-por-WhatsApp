# Copiar a .env (chmod 600). NUNCA subir .env al repo.
OPERADOR_DOMINIO=tudominio.com      # la consola queda en operador.tudominio.com
EMAIL_ACME=tu@correo.com            # avisos de Let's Encrypt
OPERADOR_IPS=203.0.113.5          # IPs permitidas a la consola (separadas por espacio); alternativa: tunel SSH (vps.md)
OPERADOR_CLAVE=cambiar-por-clave-larga-16+   # minimo 12 caracteres
WEB_SECRET=                         # python -c "import secrets;print(secrets.token_hex(32))"
DEEPSEEK_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic   # modelo barato para pruebas (DeepSeek); quitar y usar ANTHROPIC_API_KEY para Claude
LLM_MODEL=deepseek-v4-flash
# PIN del dueno: lo crea la consola al dar de alta («Nuevo cliente»); aqui no va. PANEL_PIN_<SLUG> solo sirve de semilla para clientes anteriores.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Panel por cliente: PANEL_PUBLICO=1 (ya fijado en docker-compose para alojar) o PANEL_PUBLICO_<SLUG>=1 para uno solo.
# ALOJAR_HOST=0.0.0.0 (fijado en docker-compose: dentro de Docker; en local queda 127.0.0.1).
# Variables opcionales por cliente (REPARTIDORES_<SLUG>, RESTAURANTE_LAT_<SLUG>, ...): ver MOTOR.md, alojar.

# Copia de seguridad diaria (sqlite -> /datos/backups, y rsync opcional)
HORA_RESPALDO=03:30
DIAS_RESPALDO=14                    # dias que se guardan en el VPS
RESPALDO_DESTINO=                   # vacio = solo local. Ej: usuario@caja.ejemplo.com:/backups/bot
SSH_CLAVE=/root/.ssh/respaldo_ed25519   # ruta en el VPS de la clave privada para rsync
